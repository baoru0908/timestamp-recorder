<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="34" />

    <!-- 安全设计：不申请任何权限，没有 INTERNET 权限，App 完全离线运行 -->

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.Timestamp"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".EventDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Timestamp" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:theme="@style/Theme.Timestamp" />

        <activity
            android:name=".TutorialActivity"
            android:exported="false"
            android:theme="@style/Theme.Timestamp" />

        <activity
            android:name=".StatsActivity"
            android:exported="false"
            android:theme="@style/Theme.Timestamp" />

        <activity
            android:name=".WidgetSingleConfigureActivity"
            android:exported="true"
            android:theme="@style/Theme.Timestamp">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- 桌面小组件类型一：全部事件列表 -->
        <receiver
            android:name=".TimestampWidgetProvider"
            android:label="@string/widget_all_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_all_info" />
        </receiver>

        <!-- 桌面小组件类型二：单事件大按钮（创建时绑定事件） -->
        <receiver
            android:name=".WidgetSingleProvider"
            android:label="@string/widget_single_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_single_info" />
        </receiver>

        <!-- 桌面小组件类型三：单事件 2×1 胶囊（创建时绑定事件） -->
        <receiver
            android:name=".WidgetCapsuleProvider"
            android:label="@string/widget_capsule_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_capsule_info" />
        </receiver>

        <!-- 桌面小组件类型四：自定义（自选事件 + 标题 + 背景色） -->
        <activity
            android:name=".WidgetCustomConfigureActivity"
            android:exported="true"
            android:theme="@style/Theme.Timestamp"
            android:label="@string/widget_custom_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".WidgetCustomProvider"
            android:label="@string/widget_custom_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_custom_info" />
        </receiver>

        <!-- RemoteViewsService 已移除：「全部事件」小组件改为固定行渲染，
             不再需要 ListView + 跨进程服务（该模式在 MIUI / HyperOS 上会导致
             小组件载入失败）。详见 TimestampWidgetProvider 的注释。 -->
    </application>
</manifest>
