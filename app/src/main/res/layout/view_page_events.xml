<?xml version="1.0" encoding="utf-8"?>
<!-- 主页 · 「事件」页（ViewPager2 的第 0 页）。
     从 activity_main.xml 抽出来，交给 ViewPager2 做跟手横滑切换。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:text="@string/empty_events"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="15sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerEvents"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="@dimen/list_horizontal_padding"
        android:paddingEnd="@dimen/list_horizontal_padding"
        android:paddingTop="4dp"
        android:paddingBottom="@dimen/list_bottom_padding"
        android:scrollbars="vertical" />
</FrameLayout>
