<?xml version="1.0" encoding="utf-8"?>
<!--
  单事件小组件 · 宽扁形态（约 2×1 / 3×1 / 4×1 格）。
  一行高度：左侧事件名，右侧最近一次记录时间 + 「＋」号，点一下即记录。
  背景层 bgImage 由代码染色（见 widget_single.xml 顶部说明：规避多实例串色与 API 31 门槛）。
  内边距 = 原「根 4dp + 内容 16/14dp」的合并值，视觉与改动前一致。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_corner_r16" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <!--
          窄 2×1（实测约 144dp 宽）下，时间 + 加号图标会把事件名挤到只剩几个 dp，
          中文名连省略号都放不下 → 整块空白（BUG-4）。
          对策：① 缩小内边距；② tvName 设 minWidth 保住名字；③ 代码在宽度不足时隐藏加号图标。
        -->
        <TextView
            android:id="@+id/tvName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="44dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#E6FFFFFF"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:ellipsize="end"
            android:maxLines="1" />

        <!-- 「＋」用文字而不是矢量图标：
             ① 小组件里要给图标换前景色只能走 setColorFilter，而多个实例共用同一个
                drawable 资源 id 时滤镜会写进共享 ConstantState → 异色实例互相串色（BUG-1/订正）；
             ② setTextColor 是 RemoteViews 上**明确安全**的着色通道（文字不共享 ConstantState）。
             所以这里放一个文字加号，颜色由 WidgetSingleProvider 按背景亮度写入。 -->
        <TextView
            android:id="@+id/ivIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/glyph_plus"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:importantForAccessibility="no" />
    </LinearLayout>
</FrameLayout>
