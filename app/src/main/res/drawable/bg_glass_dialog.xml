<?xml version="1.0" encoding="utf-8"?>
<!-- 玻璃浮层的底（取色器等自绘 Dialog 用）：圆角 24dp + 极淡描边 + 与确认弹窗同色的面。
     用 App 自己的颜色资源（夜/日各一套），所以不会出现"浮层是白底、文字用夜间色"的错配。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_dialog" />
    <corners android:radius="@dimen/radius_xl" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
</shape>
