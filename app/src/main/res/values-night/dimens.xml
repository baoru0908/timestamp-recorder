<?xml version="1.0" encoding="utf-8"?>
<!--
  深色模式的玻璃参数覆盖。

  ⚠️ 这里**只覆盖"着色浓度"**：模糊半径与折射高度深浅色共用（见 values/dimens.xml）——
  折射带就是"液体"感的来源，收窄它等于削掉设计语言本体（2026-09-21 踩过：为了压住顶栏
  把折射从 16dp 收到 10dp、浓度从 38% 加到 72%，结果玻璃变成实心黑，已全部回退）。

  为什么浓度需要分深浅色：
  玻璃的遮蔽力来自 ①高斯模糊（降低锐度）②tint 着色（降低对比度）。
  浅色模式（浅底深字）下模糊本身就能把深字洗淡；深色模式（深底浅字）下模糊只让字边发虚、
  亮度几乎不变，所以要靠浓度区分「薄玻璃（观感优先）」与「厚玻璃（可读性优先）」。
-->
<resources>

    <!-- 主页的胶囊岛 + 顶部玻璃栏：38% —— 薄薄一层冷色雾，内容从玻璃底下透出来、
         被折射与模糊打散。这是「液体玻璃」设计语言的本体，不要为了"压住内容"而加厚。 -->
    <integer name="glass_tint_alpha">38</integer>

    <!-- 二级页顶栏：72% —— 这里条目不定期从标题下面穿过，可读性优先；
         配合 bg_top_scrim 遮罩一起用，标题行永远有一个确定的底。
         （主人 2026-09-21 明确：设置页顶栏暂时保持现状） -->
    <integer name="glass_tint_alpha_solid">72</integer>

</resources>
