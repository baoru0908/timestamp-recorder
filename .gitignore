# Gradle / 构建产物
.gradle/
build/
build_log.txt
release_log.txt
captures/
.externalNativeBuild/
.cxx/

# 本机配置（含 Android SDK 路径）
local.properties

# 字体源文件：官方全量的 MiSans（约 7.5MB/字重），只用于
